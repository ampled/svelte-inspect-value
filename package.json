{
  "name": "inspect-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ampled/svelte-inspect-value.git"
  },
  "homepage": "https://inspect.eirik.space",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm dev:docs && pnpm dev:sv",
    "dev:sv": "pnpm --filter './packages/*' dev",
    "dev:docs": "pnpm --filter './apps/*' dev",
    "build": "pnpm --filter '*' build",
    "build:docs": "pnpm --filter './apps/*' build",
    "preview": "pnpm --filter '*' preview",
    "format": "prettier --write .",
    "prettiercheck": "prettier --check .",
    "lint": "prettier --check . && eslint .",
    "lint:ci": "prettier --check . && eslint --max-warnings 1 .",
    "eslint": "eslint ."
  },
  "type": "module",
  "devDependencies": {
    "@typescript-eslint/parser": "^8.58.0",
    "@types/node": "^24",
    "@eslint/compat": "^2.0.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-css-order": "^2.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.1",
    "globals": "^17.4.0"
  }
}
